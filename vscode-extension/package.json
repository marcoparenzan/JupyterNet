{
  "name": "jupyternet-notebook",
  "displayName": "JupyterNet Notebook",
  "description": "C#, F#, PowerShell, Power Fx, PySharp, Ontly and Ralf .ipynb notebooks in VS Code, backed by a JupyterNet.Host process.",
  "version": "0.1.0",
  "publisher": "marcoparenzan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Notebooks", "Programming Languages", "Machine Learning"],
  "activationEvents": [
    "onNotebook:jupyternet-notebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "notebooks": [
      {
        "type": "jupyternet-notebook",
        "displayName": "JupyterNet Notebook",
        "priority": "option",
        "selector": [{ "filenamePattern": "*.ipynb" }]
      }
    ],
    "notebookRenderer": [
      {
        "id": "jupyternet-html-renderer",
        "displayName": "JupyterNet HTML output",
        "entrypoint": "./out/renderer/index.js",
        "mimeTypes": ["text/html"]
      }
    ],
    "languages": [
      { "id": "csharp", "extensions": [".cs"] },
      { "id": "fsharp", "extensions": [".fs"] },
      { "id": "powerfx", "aliases": ["Power Fx"] },
      { "id": "pysharp", "aliases": ["PySharp"] },
      { "id": "ontly", "aliases": ["Ontly"] },
      { "id": "ralf", "aliases": ["Ralf"] }
    ],
    "commands": [
      {
        "command": "jupyternet.newNotebook",
        "title": "JupyterNet: New Notebook",
        "category": "JupyterNet"
      },
      {
        "command": "jupyternet.restartHost",
        "title": "JupyterNet: Restart Kernel Host",
        "category": "JupyterNet"
      }
    ],
    "configuration": {
      "title": "JupyterNet",
      "properties": {
        "jupyternet.hostDll": {
          "type": "string",
          "default": "",
          "description": "Path to JupyterNet.Host.dll. Empty uses the copy bundled with the extension (host/JupyterNet.Host.dll)."
        },
        "jupyternet.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "The 'dotnet' executable used to run JupyterNet.Host."
        },
        "jupyternet.kernelPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "D:\\dev\\2026\\repos\\PySharp\\src\\JupyterNet.Kernels.PySharp\\bin\\publish",
            "D:\\dev\\2026\\repos\\ontly\\src\\JupyterNet.Kernels.Ontly\\bin\\publish",
            "D:\\dev\\MarcoParenzan\\RalfAI\\src\\JupyterNet.Kernels.Ralf\\bin\\publish"
          ],
          "description": "Directories JupyterNet.Host scans for kernel plugins (pysharp/ontly/ralf), forwarded to it as JUPYTERNET_KERNEL_PATHS. Each is one plugin's own 'dotnet publish' output. Defaults to this machine's three plugin repos; override per workspace if they live elsewhere."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json && tsc -p ./tsconfig.renderer.json",
    "watch": "tsc -w -p ./tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
