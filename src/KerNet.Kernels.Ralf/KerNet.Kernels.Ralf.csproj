<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KerNet.Kernels.Ralf</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>KerNet kernel that embeds RalfAI's AgentEngine as a notebook cell language, with tools to inspect, run and edit the notebook's other cells.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RalfAI.Core" Version="1.0.0" />
    <PackageReference Include="RalfAI.Abstractions" Version="1.0.0" />
    <PackageReference Include="RalfAI.Providers" Version="1.0.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KerNet.Kernels.Abstractions\KerNet.Kernels.Abstractions.csproj" />
  </ItemGroup>

</Project>
