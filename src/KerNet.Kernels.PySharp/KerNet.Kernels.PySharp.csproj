<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KerNet.Kernels.PySharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>KerNet kernel that runs Python cells on PySharp (PySharpLib.PyEngine), with session state shared across cells.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PySharp.Interpreter" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KerNet.Kernels.Abstractions\KerNet.Kernels.Abstractions.csproj" />
  </ItemGroup>

</Project>
