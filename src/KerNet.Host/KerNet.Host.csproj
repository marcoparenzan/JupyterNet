<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>KerNet.Host</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>KerNet's kernel host: reads NDJSON execute requests on stdin, dispatches to the csharp/pysharp/ontly/ralf kernels, writes NDJSON output events on stdout.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kernet-host</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KerNet.Protocol\KerNet.Protocol.csproj" />
    <ProjectReference Include="..\KerNet.Kernels.Abstractions\KerNet.Kernels.Abstractions.csproj" />
    <ProjectReference Include="..\KerNet.Kernels.CSharp\KerNet.Kernels.CSharp.csproj" />
    <ProjectReference Include="..\KerNet.Kernels.PySharp\KerNet.Kernels.PySharp.csproj" />
    <ProjectReference Include="..\KerNet.Kernels.Ontly\KerNet.Kernels.Ontly.csproj" />
    <ProjectReference Include="..\KerNet.Kernels.Ralf\KerNet.Kernels.Ralf.csproj" />
  </ItemGroup>

</Project>
