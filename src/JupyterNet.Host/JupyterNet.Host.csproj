<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JupyterNet.Host</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>JupyterNet's kernel host: reads NDJSON execute requests on stdin, runs the builtin csharp/fsharp kernels plus any kernel plugins found via JUPYTERNET_KERNEL_PATHS (PySharp/Ontly/Ralf live in their own repos), writes NDJSON output events on stdout.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jupyternet-host</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JupyterNet.Protocol\JupyterNet.Protocol.csproj" />
    <ProjectReference Include="..\JupyterNet.Kernels.Abstractions\JupyterNet.Kernels.Abstractions.csproj" />
    <ProjectReference Include="..\JupyterNet.Kernels.CSharp\JupyterNet.Kernels.CSharp.csproj" />
    <ProjectReference Include="..\JupyterNet.Kernels.FSharp\JupyterNet.Kernels.FSharp.csproj" />
  </ItemGroup>

</Project>
