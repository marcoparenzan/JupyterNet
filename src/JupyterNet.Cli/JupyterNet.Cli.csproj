<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JupyterNet.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>Headless CLI for JupyterNet: runs a .ipynb notebook's cells top to bottom without VS Code, for CI or scripting. Built on JupyterNet.Engine, the same engine JupyterNet.Host and any embedding application use.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jupyternet</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JupyterNet.Engine\JupyterNet.Engine.csproj" />
  </ItemGroup>

</Project>
